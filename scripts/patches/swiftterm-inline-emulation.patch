+    /// Clears orphaned halves when an overwrite or erase cuts across a
+    /// multi-column glyph at either boundary of `start..<end`.
+    func clearSplitWideGlyphs (start: Int, end: Int)
+    {
+        let length = dataSize
+        guard start < end, start < length, end > 0 else { return }
+        let clampedStart = max (0, start)
+        let clampedEnd = min (length, end)
+
+        if clampedStart > 0 && data [clampedStart].width == 0 && data [clampedStart].code == 0 {
+            var lead = clampedStart - 1
+            while lead > 0 && data [lead].width == 0 && data [lead].code == 0 {
+                lead -= 1
+            }
+            if Int (data [lead].width) > 1 && lead + Int (data [lead].width) > clampedStart {
+                let blank = CharData (attribute: data [lead].attribute)
+                for i in lead..<clampedStart {
+                    data [i] = blank
+                }
+            }
+        }
+
+        if clampedEnd < length && data [clampedEnd].width == 0 && data [clampedEnd].code == 0 {
+            var lead = clampedEnd - 1
+            while lead > 0 && data [lead].width == 0 && data [lead].code == 0 {
